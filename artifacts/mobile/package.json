{
  "name": "@workspace/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "build-web": "node scripts/build-web.js",
    "serve-web": "node server/serve-web.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && pnpm run test:server",
    "test:server": "node --test server/*.test.cjs",
    "test:browser:payment-return": "pnpm run build-web && playwright test --config playwright.payment-return.config.cjs",
    "test:browser:landing-page": "playwright test --config playwright.landing-page.config.cjs",
    "check:published-payment-return": "node scripts/check-published-payment-return.cjs",
    "monitor:published-payment-return": "node scripts/run-published-payment-monitor.cjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/cli": "54.0.23",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@playwright/test": "^1.64.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
